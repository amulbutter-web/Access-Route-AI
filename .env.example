# Copy to .env (never commit .env). Read by docker-compose*.yml.
# For running the backend directly with `npm run dev`, use backend/.env instead.

# TinyFish API key — server-side only. The backend refuses to start without it.
TINYFISH_API_KEY=

# --- Ingestion service only (docker-compose.ingestion.yml) ---
INGESTION_ADMIN_TOKEN=change-me
DATABASE_URL=postgresql+psycopg://accessroute:accessroute@postgres:5432/accessroute
REDIS_URL=redis://redis:6379/0
# Runs the approved source every 15 minutes inside the API process. Use one worker replica only,
# or replace this dev scheduler with the deployment scheduler plus a distributed lock.
INGESTION_SCHEDULER_ENABLED=false
PERSISTENT_STORE_ENABLED=false
